# apps/web — Vercel (docs/DEPLOY.md)
NEXT_PUBLIC_CHAIN_ID=4663
# Supported chains: mainnet 4663 (default), testnet 46630. Public values are fixed at build time.
# Dedicated browser-safe RPC, or /api/rpc via the API proxy. Empty uses the selected chain's
# rate-limited public RPC. Wallet chain-add and SSR also use that public fallback for relative URLs.
# The effective endpoint must report NEXT_PUBLIC_CHAIN_ID; a mismatch blocks reads and wallet actions.
NEXT_PUBLIC_RPC_URL=
# Mainnet defaults to the existing Pons deployment. Testnet REQUIRES BOTH target overrides;
# missing/invalid targets stop configuration rather than falling back to mainnet contracts.
NEXT_PUBLIC_PONS_LAUNCH_FACTORY=
NEXT_PUBLIC_PONS_LAUNCH_AND_BUY=
# ERC-20 pair catalog override. Empty: mainnet catalog on 4663, no ERC-20 pairs on 46630.
# Must be a JSON array (use [] for no ERC-20 pairs, not null). Native ETH is always available.
# Example (replace with a deployment on the selected chain):
# NEXT_PUBLIC_PAIR_TOKENS_JSON='[{"address":"0x...","symbol":"TEST","name":"Test Token","decimals":18,"kind":"stable"}]'
NEXT_PUBLIC_PAIR_TOKENS_JSON=
# Empty: existing official token on mainnet, hidden on testnet. Override displays as DOCK.
NEXT_PUBLIC_OFFICIAL_TOKEN_ADDRESS=
# Testnet requires an injected wallet with test ETH. Never place signer keys/secrets in NEXT_PUBLIC_*.
# Production: /api, proxied to the Railway API so the session cookie stays on this site.
# Local dev: http://localhost:8787 (direct), or /api with API_PROXY_TARGET=http://localhost:8787.
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=https://<api-service>.up.railway.app
# The live feed connects to the API directly (WebSockets can't go through the proxy).
NEXT_PUBLIC_WS_URL=wss://<api-service>.up.railway.app/ws
# Reown project id. Without it only injected and Coinbase wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_PINATA_GATEWAY=
# PostHog project key (public, phc_…); analytics are off without it. Host: https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# The site's own URL for link previews and WalletConnect metadata. Defaults to https://www.dockhood.com.
NEXT_PUBLIC_SITE_URL=
