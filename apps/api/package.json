{
  "name": "@hood/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "verifier": "tsx src/verifierWorker.ts",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "verify:local": "tsx scripts/local-verification-e2e.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/websocket": "11.3.3",
    "@hood/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "multiformats": "14.0.5",
    "openai": "7.30.0",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "drizzle-kit": "0.31.11",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
