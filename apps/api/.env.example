# apps/api — Railway (docs/BRIEF.md §13). Local: `docker compose up -d`, then copy to .env.
DATABASE_URL=postgres://hood:hood@127.0.0.1:54320/hood
REDIS_URL=redis://127.0.0.1:63790
PORT=8787
# The web app's origins. Also the hosts sign-in messages may name, and the origins allowed on /ws.
CORS_ORIGINS=http://localhost:3000
# Network: only 4663 (mainnet, default) and 46630 (testnet) are supported.
CHAIN_ID=4663
# Dedicated RPC in production; otherwise uses the selected network's public RPC.
# Startup checks eth_chainId and refuses a mismatched endpoint.
RPC_URL_SERVER=
# Mainnet defaults preserve the shipped deployment. BOTH targets are REQUIRED on testnet;
# never substitute mainnet addresses. Use a separate API database/Redis/indexer per network.
PONS_LAUNCH_FACTORY=
PONS_LAUNCH_AND_BUY=
# Optional JSON array of ERC-20 pair metadata (not native ETH):
# [{"address":"0x...","symbol":"USDG","name":"USD Global","decimals":6,"kind":"stable"}]
# Testnet defaults to no ERC-20 pairs; native ETH remains available.
PAIR_TOKENS_JSON=
# Optional official DOCK token override. Mainnet uses the shipped token; testnet defaults to none.
OFFICIAL_TOKEN_ADDRESS=
# Without a key every statement comes back unscored (grey badge).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Without a JWT a dev pinner computes CIDs locally and publishes nothing (refused in production).
PINATA_JWT=
# 32+ random characters in production.
SESSION_SECRET=
# Leave empty when the web app proxies /api to this service (docs/DEPLOY.md): the cookie then belongs to
# the web app's host. Only for a shared parent domain (web.example.com + api.example.com): .example.com
COOKIE_DOMAIN=
# Envio indexer GraphQL (apps/indexer). Local: docker compose --profile indexer up -d → http://localhost:8080/v1/graphql.
# Required in production; without it the API scans RPC logs, which free-tier RPC plans cap at a few blocks.
# Must serve only CHAIN_ID; startup validates chain_metadata before indexing/serving requests.
ENVIO_GRAPHQL_URL=
# Callouts: wallets shown as official, and extra blocklist terms (comma-separated).
OFFICIAL_WALLETS=
BLOCKLIST_EXTRA=
